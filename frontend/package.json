{
  "name": "clinic-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:host": "vite --mode host",
    "build:host": "vite build --mode host",
    "dev:reception": "vite --mode reception",
    "build:reception": "vite build --mode reception",
    "preview": "vite preview",
    "tauri:host:dev": "cp -rf src-tauri-host/. src-tauri/ && tauri dev",
    "tauri:host:build": "cp -rf src-tauri-host/. src-tauri/ && tauri build",
    "tauri:host:build:windows": "cp -rf src-tauri-host/. src-tauri/ && tauri build --target x86_64-pc-windows-gnu",
    "tauri:reception:dev": "cp -rf src-tauri-reception/. src-tauri/ && tauri dev",
    "tauri:reception:build": "cp -rf src-tauri-reception/. src-tauri/ && tauri build",
    "tauri:reception:build:windows": "cp -rf src-tauri-reception/. src-tauri/ && tauri build --target x86_64-pc-windows-gnu"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.1",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  }
}
